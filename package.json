{
  "name": "starsector-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "benchmark:collision": "node scripts/benchmark-collision.mjs",
    "import:content": "node scripts/import-game-content.mjs",
    "preview": "vite preview",
    "import:catalog": "node scripts/import-native-catalog.mjs",
    "import:refit-factions": "node scripts/import-refit-factions.mjs",
    "import:all": "npm run import:content && npm run import:catalog && npm run import:refit-factions",
    "lan": "npm run build && node server/lan-server.mjs",
    "lan:serve": "node server/lan-server.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
