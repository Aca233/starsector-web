  "specials": {
    "topographic_data": {
      "soundId": "ui_chip_pickup",
      "plugin": "com.fs.starfarer.api.campaign.impl.items.BaseSpecialItemPlugin",
      "stackSize": 1000,
      "cargoSpace": 1,
      "soundIdDrop": "ui_modspec_drop",
      "name": "超空间测绘数据",
      "icon": "graphics/icons/cargo/hyperspace_data.png",
      "params": "",
      "basePrice": 50000,
      "manufacturer": "",
      "desc": "这台有着基本资安措施的 TriPad 依照 人之领 开拓者们传承而下的数据格式规则，囊括了英仙座星域某片超空间最近流况数据的详尽扫描与分析结果。像这样的数据对前往 核心世界 之外探索远征的成功而言是不可或缺的。"
    },
    "shrouded_mantle": {
      "soundId": "ui_cargo_special_biotech_pickup",
      "plugin": "com.fs.starfarer.api.campaign.impl.items.ShroudedHullmodItemPlugin",
      "stackSize": 1000,
      "cargoSpace": 1,
      "soundIdDrop": "ui_cargo_special_bio_drop",
      "name": "渊幕套膜",
      "icon": "graphics/icons/cargo/shrouded_mantle.png",
      "params": "shrouded_mantle",
      "basePrice": 50000,
      "manufacturer": "渊幕原种",
      "desc": "\"咱们没法将能量永远储存在这种理论级的模拟等离子体中，能量总得有个去处。\"\r\n\r\n\"—— 反转幅能转换器的极性，再让驱动场产生脉冲波动。这样一来，就能对局部时空产生一次轻微扰动。这种扰动也会作用在舰船身上。\"\r\n\r\n\"但愿这招有用。\""
    },
    "threat_processing_unit": {
      "soundId": "ui_cargo_special_industrial_pickup",
      "plugin": "com.fs.starfarer.api.campaign.impl.items.BaseSpecialItemPlugin",
      "stackSize": 1000,
      "cargoSpace": 1,
      "soundIdDrop": "ui_cargo_special_industrial_drop",
      "name": "威胁处理单元",
      "icon": "graphics/icons/cargo/threat_processing_unit.png",
      "params": "",
      "basePrice": 15000,
      "manufacturer": "威胁",
      "desc": "一种基础的模块化计算单元。这类单元似乎被大量投入使用，用来支撑 威胁 船只的各项功能。其原理尚未完全明了，但其显然远未达到任何等级人工智能的门槛。"
    },
    "shrouded_thunderhead": {
      "soundId": "ui_cargo_special_biotech_pickup",
      "plugin": "com.fs.starfarer.api.campaign.impl.items.ShroudedHullmodItemPlugin",
      "stackSize": 1000,
      "cargoSpace": 1,
      "soundIdDrop": "ui_cargo_special_bio_drop",
      "name": "渊幕云砧",
      "icon": "graphics/icons/cargo/shrouded_thunderhead.png",
      "params": "shrouded_thunderhead",
      "basePrice": 30000,
      "manufacturer": "渊幕原种",
      "desc": "\"这种自持式反应会产生巨大的能量，这些能量会周期性地朝着它的，呃，目标释放。我以前不可能说一场风暴会带着恶意，但现在...\"\r\n\r\n—— 截获音频日志，发言者身份未知"
    },
    "shrouded_lens": {
      "soundId": "ui_cargo_special_biotech_pickup",
      "plugin": "com.fs.starfarer.api.campaign.impl.items.ShroudedHullmodItemPlugin",
      "stackSize": 1000,
      "cargoSpace": 1,
      "soundIdDrop": "ui_cargo_special_bio_drop",
      "name": "渊幕瞳晶",
      "icon": "graphics/icons/cargo/shrouded_lens.png",
      "params": "shrouded_lens",
      "basePrice": 30000,
      "manufacturer": "渊幕原种",
      "desc": "\"该装置在战术机动过程中启动时，通过调整由驱动场稳定器改造而成的 '探测器' 的频率，可以制造出超空间裂隙，而这些裂隙将对正常空间内的结构造成严重破坏，比如一艘星舰。\""
    },
    "planetkiller": {
      "soundId": "ui_cargo_special_military_pickup",
      "plugin": "com.fs.starfarer.api.campaign.impl.items.BaseSpecialItemPlugin",
      "stackSize": 1000,
      "cargoSpace": 1,
      "soundIdDrop": "ui_cargo_special_military_drop",
      "name": "行星杀手",
      "icon": "graphics/icons/cargo/planetkiller.png",
      "params": "",
      "basePrice": 1000000,
      "manufacturer": "人之领管制科技",
      "desc": "一颗足以使星球分崩离析的专用弹头。人们关于其运作原理知之甚少，只知道其通过将某种形式的共振和星球本身的自转共同产生作用。\r\n\r\n这颗弹头被上了保险，需要某些大概失传已久的授权代码才能解锁。目前它就只是一台死气沉沉的复杂机械而已。"
    },
    "fragment_fabricator": {
      "soundId": "ui_cargo_special_industrial_pickup",
      "plugin": "com.fs.starfarer.api.campaign.impl.items.BaseSpecialItemPlugin",
      "stackSize": 1000,
      "cargoSpace": 1,
      "soundIdDrop": "ui_cargo_special_industrial_drop",
      "name": "碎片仿织器",
      "icon": "graphics/icons/cargo/fragment_fabricator.png",
      "params": "",
      "basePrice": 20000,
      "manufacturer": "威胁",
      "desc": "这是一项沿用了旧时 人之领 时代工程标准的陌生技术。装有多组具备自适应能力的能源与原料接口。该设备不存在指令接口：任何干扰其运行的举动，都会触发具有攻击性的自我维修机制；如果对其进行大规模拆解，可能引发设备自毁。\r\n\r\n这显然是一台制造设备，只要提供足够的能源与原料供给，它会生产出 \"碎片单元\"。每个碎片单元由分形组件按独特结构排列，功能基本一致，仅在尺寸上存在细微差异。尽管单个碎片单元结构简单，但多组单元聚合后，会突显复杂行为。"
    }
  },
